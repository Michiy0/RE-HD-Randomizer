; Exports identiques (numéros compris) à C:\Windows\SysWOW64\xinput1_4.dll.
; bhd.exe importe XInput par numéro : #2, #3, #4 et #5.
LIBRARY xinput1_4.dll
EXPORTS
    XInputGetState=XInputGetState@8                           @2
    XInputSetState=XInputSetState@8                           @3
    XInputGetCapabilities=XInputGetCapabilities@12            @4
    XInputEnable=XInputEnable@4                               @5
    XInputGetBatteryInformation=XInputGetBatteryInformation@12 @7
    XInputGetKeystroke=XInputGetKeystroke@12                  @8
    XInputGetAudioDeviceIds=XInputGetAudioDeviceIds@20        @10
    XInputGetStateEx=XInputGetStateEx@8                       @100 NONAME
    XInputWaitForGuideButton=XInputWaitForGuideButton@12      @101 NONAME
    XInputCancelGuideButtonWait=XInputCancelGuideButtonWait@4 @102 NONAME
    XInputPowerOffController=XInputPowerOffController@4       @103 NONAME
    XInputGetBaseBusInformation=XInputGetBaseBusInformation@8 @104 NONAME
    XInputGetCapabilitiesEx=XInputGetCapabilitiesEx@16        @108 NONAME
